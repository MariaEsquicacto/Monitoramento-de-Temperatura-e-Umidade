# ==============================================================================
# CONFIGURAÇÕES DO SERVIÇO DE SINCRONIZAÇÃO FIREBASE - PYTHONANYWHERE
# ==============================================================================

# URL da instância do Firebase Realtime Database (com barra final)
FIREBASE_DATABASE_URL=https://gemini-project---analise-5f616-default-rtdb.firebaseio.com/

# ID do Projeto no Firebase / Google Cloud
FIREBASE_PROJECT_ID=gemini-project---analise-5f616

# Caminho do arquivo de credenciais da Conta de Serviço (Service Account)
# Gerado no Firebase Console > Configurações do Projeto > Contas de Serviço
FIREBASE_SERVICE_ACCOUNT_KEY=serviceAccountKey.json

# Intervalo entre as coletas em segundos (Requisito: 20 segundos)
SYNC_INTERVAL_SECONDS=20

# Coleção principal no Firestore onde cada snapshot será gravado
FIRESTORE_COLLECTION_MAIN=leituras_ambiente

# Espelha leituras individuais na coleção 'readings_history' (true/false)
# Mantém compatibilidade com os gráficos e tabelas históricas do Web App
SYNC_TO_READINGS_HISTORY=true
FIRESTORE_COLLECTION_HISTORY=readings_history

# Nó a ser lido no Realtime Database ('/' para raiz ou 'ambiente' para apenas ambiente)
RTDB_NODE=/
